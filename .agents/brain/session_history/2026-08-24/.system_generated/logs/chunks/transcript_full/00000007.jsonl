37:                 for line in f:\n38:                     if \"=\" in line:\n39:                         k, v = line.split(\"=\", 1)\n40:                         k_clean = k.strip().replace(\"[\", \"\").replace(\"]\", \"\")\n41:                         if k_clean in (\"deepseek-v4-pro\", \"DEEPSEEK_API_KEY\"):\n42:                             val = v.strip()\n43:                             if val:\n44:                                 return val\n45:         except Exception:\n46:             pass\n47:     return None\n48: \n49: class ServiceDayMultiAuditor:\n50:     def __init__(self, year=2026, start_date_str=None, end_date_str=None, call_deepseek=False):\n51:         self.year = year\n52:         self.engine = RuthenianEngine(base_dir=str(PROJECT_ROOT))\n53:         self.resolver_calls = extract_resolver_calls_from_structures(str(PROJECT_ROOT))\n54:         self.call_deepseek_flag = call_deepseek\n55:         self.deepseek_key = get_deepseek_key()\n56:         \n57:         if start_date_str:\n58:             self.start_date = date.fromisoformat(start_date_str)\n59:         else:\n60:             self.start_date = date(self.year, 1, 1)\n61:             \n62:         if end_date_str:\n63:             self.end_date = date.fromisoformat(end_date_str)\n64:         else:\n65:             self.end_date = date(self.year, 12, 31)\n66:             \n67:         self.audit_dir = PROJECT_ROOT / \"audit_results\"\n68:         self.audit_dir.mkdir(exist_ok=True)\n69:         \n70:         # State tracking for sliding context (continuity)\n71:         self.sliding_state = {}\n72: \n73:     def extract_service_digest_section(self, digest_text: str, service_name: str) -> str:\n74:         \"\"\"Extract the specific service section from the generated digest.\"\"\"\n75:         lines = digest_text.splitlines()\n76:         preamble = []\n77:         service_lines = []\n78:         \n79:         mapping = {\n80:             \"Vespers\": [\"## GREAT VESPERS\", \"## VESPERS\", \"## PASCHAL VESPERS\", \"## LENTEN VESPERS\"],\n81:             \"Compline\": [\"## SMALL COMPLINE\", \"## COMPLINE\", \"## GREAT COMPLINE\"],\n82:             \"Midnight Office\": [\"## MIDNIGHT OFFICE\", \"## MIDNIGHT OFFICE (SUNDAY)\", \"## MIDNIGHT OFFICE (SATURDAY)\"],\n83:             \"Matins\": [\"## FESTAL MATINS\", \"## MATINS\", \"## DAILY MATINS\", \"## SUNDAY MATINS\", \"## LENTEN MATINS\"],\n84:             \"First Hour\": [\"## FIRST HOUR\", \"## LENTEN FIRST HOUR\", \"## ROYAL FIRST HOUR\"],\n85:             \"Third Hour\": [\"## THIRD HOUR\", \"## LENTEN THIRD HOUR\", \"## ROYAL THIRD HOUR\"],\n86:             \"Sixth Hour\": [\"## SIXTH HOUR\", \"## LENTEN SIXTH HOUR\", \"## ROYAL SIXTH HOUR\"],\n87:             \"Ninth Hour\": [\"## NINTH HOUR\", \"## LENTEN NINTH HOUR\", \"## ROYAL NINTH HOUR\"],\n88:             \"Liturgy\": [\"## DIVINE LITURGY\", \"## LITURGY\"]\n89:         }\n90:         \n91:         target_headers = [h.upper() for h in mapping.get(service_name, [])]\n92:         all_headers = []\n93:         for hdrs in mapping.values():\n94:             all_headers.extend([h.upper() for h in hdrs])\n95:             \n96:         started = False\n97:         for line in lines:\n98:             upper_line = line.strip().upper()\n99:             is_any_header = any(upper_line.startswith(h) for h in all_headers)\n100:             is_target_header = any(upper_line.startswith(h) for h in target_headers)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
