nd(\"troparion of the Saint\")\r\n53:                         elif c == \"trop_saint_2\":\r\n54:                             if len(saints) >= 2:\r\n55:                                 comps.append(f\"troparion of {self._clean_name(saints[1].get('name', 'second Saint'))}\")\r\n56:                             else:\r\n57:                                 comps.append(\"troparion of the second Saint\")\r\n58:                         elif c == \"trop_day\":\r\n59:                             comps.append(\"troparion of the Day\")\r\n60:                         elif c == \"trop_temple\":\r\n61:                             comps.append(\"troparion of the Temple\")\r\n62:                         elif c == \"trop_feast\":\r\n63:                             title_lower = context.get(\"dolnytsky_title\", \"\").lower()\r\n64:                             lbl = \"forefeast\" if \"forefeast\" in title_lower or \"prefeast\" in title_lower else \"afterfeast\" if \"afterfeast\" in title_lower else \"feast\"\r\n65:                             comps.append(f\"troparion of the {lbl}\")\r\n66:                         elif c in (\"glory\", \"both_now\"):\r\n67:                             pass\r\n68:                         else:\r\n69:                             comps.append(self.humanize_key(c))\r\n70:                     first = comps[0]\r\n71:                     others = comps[1:]\r\n72:                     if others:\r\n73:                         trop_str = f\"{first}, Glory... {', '.join(others)}\"\r\n74:                     else:\r\n75:                         trop_str = first\r\n76:                 troparia_by_hour[h] = trop_str\r\n77:             except Exception as e:\r\n78:                 troparia_by_hour[h] = f\"[ERROR: {e}]\"\r\n79:                 \r\n80:             try:\r\n81:                 kont_res = self.engine.resolve_hours_kontakion(h_ctx, rubrics)\r\n82:                 if isinstance(kont_res, dict):\r\n83:                     source = kont_res.get(\"source\")\r\n84:                     if source == \"resurrection\":\r\n85:                         kont_str = \"Resurrectional kontakion\"\r\n86:                     elif source == \"triodion\":\r\n87:                         kont_str = \"Kontakion of the Triodion\"\r\n88:                     elif source == \"triodion_saint\":\r\n89:                         r_title_lower = rubrics.get(\"title\", \"\").lower()\r\n90:                         if \"palamas\" in r_title_lower:\r\n91:                             kont_str = \"Kontakion of St. Gregory Palamas\"\r\n92:                         elif \"john of the ladder\" in r_title_lower or \"climacus\" in r_title_lower:\r\n93:                             kont_str = \"Kontakion of St. John Climacus\"\r\n94:                         else:\r\n95:                             kont_str = \"Kontakion of the Saint\"\r\n96:                     elif source == \"saint_or_feast\":\r\n97:                         title_lower = context.get(\"dolnytsky_title\", \"\").lower()\r\n98:                         lbl = \"Forefeast\" if \"forefeast\" in title_lower or \"prefeast\" in title_lower else \"Afterfeast\" if \"afterfeast\" in title_lower else \"Feast\"\r\n99:                         kont_str = f\"Kontakion of the {lbl}\"\r\n100:                     else:\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
