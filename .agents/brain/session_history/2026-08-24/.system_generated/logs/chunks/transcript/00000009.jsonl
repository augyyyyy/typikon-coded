\"matins_canon_distribution\")\r\n361:                 except Exception:\r\n362:                     pass\r\n363:         if overridden_dist:\r\n364:             if isinstance(overridden_dist, dict):\r\n365:                 # Check for Logic Switch\r\n366:                 if \"logic_switch\" in overridden_dist:\r\n367:                     s_count = len(context.get(\"saints\", []))\r\n368:                     switch_key = \"1_saint\"\r\n369:                     if s_count >= 2: \r\n370:                         switch_key = \"2_saints\"\r\n371:                     else:\r\n372:                         rank_id = self._get_rank_id(context)\r\n373:                         if rank_id == \"rank_simple_6\" or rank_id == \"rank_doxology\":\r\n374:                             switch_key = \"saint_on_6_doxology\"\r\n375:                     sub_rule = overridden_dist[\"logic_switch\"].get(switch_key, {})\r\n376:                     dist = sub_rule.get(\"distribution\", [])\r\n377:                 else:\r\n378:                     dist = overridden_dist.get(\"distribution\", [])\r\n379:             elif isinstance(overridden_dist, list):\r\n380:                 dist = overridden_dist\r\n381:             else:\r\n382:                 dist = []\r\n383:                 \r\n384:             # Normalize qty to count if count is missing\r\n385:             dist_normalized = []\r\n386:             for item in dist:\r\n387:                 item_copy = item.copy()\r\n388:                 if \"qty\" in item_copy and \"count\" not in item_copy:\r\n389:                     item_copy[\"count\"] = item_copy[\"qty\"]\r\n390:                 dist_normalized.append(item_copy)\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
