$env:PYTHONPATH="."; .venv\Scripts/python scripts/pentecostarion_fuzzer.py

# Annual Almanac commands
$env:PYTHONPATH="."; .venv\Scripts/python scripts/generate_annual_almanac.py --year 2026
$env:PYTHONPATH="."; .venv\Scripts/pytest tests/test_annual_almanac_consistency.py -v
```

