{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canon Stack Resolver Output Schema",
  "type": "object",
  "properties": {
    "total_count": { "type": "integer", "minimum": 0 },
    "distribution": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "qty": { "type": "integer", "minimum": 0 }
        },
        "required": ["type", "qty"]
      }
    }
  },
  "required": ["total_count", "distribution"]
}
