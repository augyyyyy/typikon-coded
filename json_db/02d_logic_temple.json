  "file_metadata": {
    "filename": "02d_logic_temple.json",
    "version": "3.0 (Full Part V Detail)",
    "last_updated": "2026-03-22",
    "authority": "Lviv (Dolnytsky) Typikon (2010) Part V, Chapter II",
    "scope": "Patronal Feast Logic",
    "description": "Complete temple feast conflict-resolution logic: 6 general rules + 31 specific scenarios with full stichera/canon/troparion detail."
  },
  "system_settings": {
    "trigger_condition": "is_temple_feast",
    "default_rank_override": "rank_vigil_patronal",
    "vestment_color": "gold_or_patron_color",
    "general_rules": {
      "G1": {
        "rule": "All-Night Vigil must be celebrated for temple feast, even if saint is of lower rank",
        "source_ref": "Final_Dolnytsky_part5_temple.txt"
      },
      "G2": {
        "rule": "Temple feast exceeds even saint with Vigil",
        "on_sunday": {
          "matins_before_canon": [
            "prokimenon_temple",
            "gospel_temple",
            "sticheron_temple"
          ],
          "gospel_sticheron": "transferred_from_praises_to_end_of_matins"
        },
        "on_weekday": {
          "liturgy": "Apostle and Gospel of the day excluded; read on day before feast"
        }
      },
      "G3": {
        "rule": "Temple in midst of feast (Forefeast/Afterfeast/Apodosis): follow rubric of Saint with Vigil in Afterfeast",
        "source_ref": "Final_Dolnytsky_part2_general_rubrics.txt:L788"
      },
      "G4": {
        "rule": "On feast day after Ambo prayer: Blessing of Water outside church with procession"
      },
      "G5": {
        "rule": "Day following feast: Liturgy for deceased of parish with Parastas; nothing of feast taken"
      },
      "G6": {
        "rule": "Temple feast usually transferred to following Sunday; in cathedrals celebrated on own day"
      }
    },
    "apodosis_rule": {
      "description": "Apodosis takes place on evening of feast day (Vespers for following day) with Entrance.",
      "vespers": {
        "lord_i_have_cried": {
          "total": 6,
          "distribution": "3 temple + 3 daily saint",
          "glory": "of temple",
          "both_now": "Theotokion (Sunday Dogmatic) of tone of Doxastikon",
          "if_lord_or_theotokos_temple": "Glory, Both now: of temple"
        },
        "friday_evening": "Dogmatic of tone being given away",
        "after_prokimenon": "Let us all say",
        "aposticha": "of temple with its verses; Glory: of temple; Both now: Theotokion (Sunday) of tone of Doxastikon",
        "troparia_end": "Troparion of temple; Glory: Troparion of daily saint; Glory, Both now: of temple",
        "dismissal": "Great Dismissal with commemoration of temple and daily saint"
      },
      "exceptions": "No Apodosis if following day is Sunday or Polyeleos saint"
    },
    "procession_rule": {
      "description": "Ruthenian custom of Eucharistic Procession around the church on the Patronal Feast.",
      "rubric_ref": "dolnytsky_part5_chap1"
    }
  },
  "transfer_logic": {
    "description": "Rules for transferring temple feast from forbidden days.",
    "rules": [
      {
        "conflict_period": "holy_week_monday_to_thursday",
        "action": "transfer_to_palm_sunday",
        "case": 18
      },
      {
        "conflict_period": "holy_friday_to_pascha",
        "action": "transfer_to_bright_monday_or_tuesday",
        "case": 18
      },
      {
        "conflict_period": "first_week_lent_monday",
        "action": "transfer_to_cheesefare_sunday",
        "case": 5
      },
      {
        "conflict_period": "first_week_lent_tue_to_fri",
        "action": "transfer_to_first_saturday_lent",
        "case": 6
      }
    ]
  },
