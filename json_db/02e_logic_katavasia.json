  "daily_matins_override": {
    "description": "For Daily (non-Great) Matins, Katavasia is the heirmos of the LAST canon, not seasonal",
    "source_ref": "Dolnytsky_Typikon_Master.md:1.2.2.5",
    "applies_to": "daily_matins",
    "odes_with_katavasia": [
      3,
      6,
      8,
      9
    ],
    "katavasia_source": "irmos_of_last_canon"
  },
  "selection_logic": {
    "resolve_katavasia": {
      "description": "Select Katavasia based on date, season, and service type per Dolnytsky Part V lines 244-273",
      "steps": [
        "1. If Daily Matins (rank 5 weekday) -> use heirmos of last canon (Odes 3, 6, 8, 9 only)",
        "2. If Meeting overlap (Jan 15-Feb 9) and not Meatfare Sunday -> use Meeting Katavasia",
        "3. If Triodion movable Sunday -> use Triodion Katavasia",
        "4. If Pascha/Pentecostarion period -> check pascha_seasons by offset",
        "5. Else -> match date against immovable seasons array",
        "6. Return katavasia_id, text, tone, frequency, and after_odes"
      ],
      "inputs": [
        "date",
        "rank",
        "season",
        "day_of_week",
        "pascha_offset"
      ],
      "output": "katavasia_structure"
    }
  }
